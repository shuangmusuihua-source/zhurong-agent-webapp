{
  "id": "business-simple",
  "name": "商务简白",
  "description": "商务简约风格，白底深色字，适合商务汇报场景",
  "version": "1.0.0",
  "colors": {
    "background": "#fffffe",
    "primary": "#272343",
    "secondary": "#2d334a",
    "accent": "#e3f6f5",
    "border": "#bae8e8"
  },
  "fonts": {
    "primary": "Alibaba PuHuiTi",
    "fallback": "-apple-system, BlinkMacSystemFont, sans-serif"
  },
  "layout": {
    "cover": {
      "paddingLeft": "2cm",
      "paddingRight": "2cm",
      "verticalAlign": "center",
      "textAlign": "left"
    },
    "content": {
      "paddingLeft": "1cm",
      "paddingRight": "1cm",
      "paddingTop": "0.5cm",
      "paddingBottom": "0.5cm",
      "textAlign": "left"
    },
    "end": {
      "paddingLeft": "2cm",
      "paddingRight": "2cm",
      "verticalAlign": "center",
      "textAlign": "center"
    }
  },
  "typography": {
    "coverTitle": {
      "fontSize": "3.5rem",
      "fontWeight": 700,
      "lineHeight": 1.2
    },
    "title": {
      "fontSize": "2.5rem",
      "fontWeight": 600,
      "lineHeight": 1.3
    },
    "subtitle": {
      "fontSize": "1.5rem",
      "fontWeight": 400
    },
    "content": {
      "fontSize": "1.2rem",
      "lineHeight": 1.8
    },
    "summary": {
      "fontSize": "1rem",
      "fontStyle": "italic"
    }
  },
  "animation": {
    "duration": {
      "fast": "0.3s",
      "normal": "0.5s",
      "slow": "0.8s"
    },
    "easing": "ease"
  },
  "files": {
    "style": "style.css",
    "charts": "charts.js",
    "template": "template.html"
  }
}